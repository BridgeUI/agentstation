{
  "name": "@macmini/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "各環境（host / vm1 / vm2）に常駐する監視プログラム。LLMではなく、ホワイトリストの操作だけを実行する",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@macmini/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "vitest": "^4.1.12"
  }
}
