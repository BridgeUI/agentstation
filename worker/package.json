{
  "name": "@agentstation/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ダッシュボード（静的UI）＋ API ＋ Cron を1つの Worker で配信する",
  "scripts": {
    "dev": "wrangler dev --host localhost",
    "deploy": "node ../kit/render-config.mjs && wrangler deploy -c wrangler.deploy.toml",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply agentstation --local",
    "db:migrate:remote": "node ../kit/render-config.mjs && wrangler d1 migrations apply agentstation --remote -c wrangler.deploy.toml",
    "cf-typegen": "wrangler types",
    "build:ui": "node scripts/build-ui.mjs",
    "typecheck:ui": "tsc -p ui/tsconfig.json"
  },
  "dependencies": {
    "@agentstation/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^4.20250101.0",
    "esbuild": "^0.28.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.0.0"
  }
}
